<!DOCTYPE html>
<html>
<head>
  <title>404 error</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta http-equiv="content-type" content="text/html; charset=utf-8">

  <style>
    body {
      background-color: #EFEFEF;
      color: #2E2F30;
      margin: 0;
    }

    p.error-message {
      font-size: 40px;
      color: #cc7b0a;
      text-align: center;
      font-family: arial, sans-serif;
    }
    div.headline-error {
      font-size: 200px;
      color: #cc7b0a;
      text-align: center;
      font-family: arial, sans-serif;
    }

    div > img {
      width: 100%;
      max-height: 450px;
    }
  </style>
</head>

<body>
  <!-- This file lives in public/404.html -->
  
  <div class="headline-error">
    404
  </div>
  <div>
    <img src="/images/b-g-image.jpg" alt="Error">
  </div>
  <p class="error-message" id="german-language-text">Die Seite nach der Sie suchen existiert leider nicht. Bitte überprüfen Sie Ihren Link
    oder wenden Sie sich direkt an den Betreiber dieser Seite.
  </p>
  <p class="error-message" id="english-language-text">The page you are looking for does not exist. Please check your link
    or contact the operator of this site directly.
  </p>

  <script>
    var language  = ((navigator.languages && navigator.languages[0]) || navigator.language || navigator.userLanguage || 'de').substr(0, 2);

    console.log(language);
    if(language == "de"){
      document.getElementById("german-language-text").style.display = 'block';
      document.getElementById("english-language-text").style.display = 'none';
    }else {
      document.getElementById("german-language-text").style.display = 'none';
      document.getElementById("english-language-text").style.display = 'block';
    }
  </script>
</body>
</html>
