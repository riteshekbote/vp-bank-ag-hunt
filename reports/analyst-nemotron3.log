openapi: 3.0.1
info:
    title: PSD2 API
    version: "1.0.0"

servers:
    -   url: /psd2/berlin-group/v1
        description: PSD2 production server

paths:

    #######################################################
    # Consents
    #######################################################

    /consents:
        post:
            summary: Create consent
            description: This method creates a consent resource, defining access rights to a dedicated account.
            operationId: createConsent
            tags:
                - Account Information Service (AIS)
            parameters:
                #header
                -   $ref: "#/components/parameters/X-Request-ID"
                -   $ref: "#/components/parameters/TPP-Redirect-URI"
            requestBody:
                $ref: "#/components/requestBodies/consents"
            responses:
                '201':
                    $ref: "#/components/responses/CREATED_201_Consents"
                '403':
                    $ref: "#/components/responses/FORBIDDEN_403_AIS"
                '404':
                    $ref: "#/components/responses/NOT_FOUND_404_AIS"
                '500':
                    $ref: "#/components/responses/INTERNAL_SERVER_ERROR_500_AIS"

    /consents/{consentId}:
        get:
            summary: Get consent request
            description: Returns the content of an account information consent object.
            operationId: getConsentInformation
            tags:
                - Account Information Service (AIS)
            parameters:
                #path
                -   $ref: "#/components/parameters/consentId_PATH"
                #header
                -   $ref: "#/components/parameters/X-Request-ID"
            responses:
                '200':
                    $ref: "#/components/responses/OK_200_ConsentInformation"
                '403':
                    $ref: "#/components/responses/FORBIDDEN_403_AIS"
                '404':
                    $ref: "#/components/responses/NOT_FOUND_404_AIS"
                '500':
                    $ref: "#/components/responses/INTERNAL_SERVER_ERROR_500_AIS"

        delete:
            summary: Delete consent
            description: The TPP can delete an account information consent object if needed.
            operationId: deleteConsent
            tags:
                - Account Information Service (AIS)
            parameters:
                #path
                -   $ref: "#/components/parameters/consentId_PATH"
                #header
                -   $ref: "#/components/parameters/X-Request-ID"
                -   $ref: "#/components/parameters/TPP-Redirect-URI"
            responses:
                '204':
                    $ref: "#/components/responses/NO_CONTENT_204_Consents"
                '403':
                    $ref: "#/components/responses/FORBIDDEN_403_AIS"
                '404':
                    $ref: "#/components/responses/NOT_FOUND_404_AIS"
                '500':
                    $ref: "#/components/responses/INTERNAL_SERVER_ERROR_500_AIS"

    /consents/{consentId}/status:
        get:
            summary: Consent status request
            description: Read the status of an account information consent resource.
            operationId: getConsentStatus
            tags:
                - Account Information Service (AIS)
            parameters:
                #path
                -   $ref: "#/components/parameters/consentId_PATH"
                #header
                -   $ref: "#/components/parameters/X-Request-ID"
            responses:
                '200':
                    $ref: "#/components/responses/OK_200_ConsentStatus"
                '403':
                    $ref: "#/components/responses/FORBIDDEN_403_AIS"
                '404':
                    $ref: "#/components/responses/NOT_FOUND_404_AIS"
                '500':
                    $ref: "#/components/responses/INTERNAL_SERVER_ERROR_500_AIS"

    #######################################################
    # Payment Initiation Service (PIS)
    #######################################################

    /{payment-service}/{payment-product}:
        post:
            summary: Payment initiation request
            description: This method is used to initiate a payment at the ASPSP.
            operationId: initiatePayment
            tags:
                - Payment Initiation Service (PIS)
            parameters:
                #path
                -   $ref: "#/components/parameters/paymentService"
                -   $ref: "#/components/parameters/paymentProduct"
                #header
                -   $ref: "#/components/parameters/X-Request-ID"
                -   $ref: "#/components/parameters/TPP-Redirect-URI"
                -   $ref: "#/components/parameters/PSU-IP-Address"
            requestBody:
                $ref: "#/components/requestBodies/paymentInitiation"
            responses:
                '201':
                    $ref: "#/components/responses/CREATED_201_PaymentInitiation"
                '403':
                    $ref: "#/components/responses/FORBIDDEN_403_AIS"
                '404':
                    $ref: "#/components/responses/NOT_FOUND_404_AIS"
                '500':
                    $ref: "#/components/responses/INTERNAL_SERVER_ERROR_500_AIS"

    #  /{payment-service}/{payment-id}:
    #    delete:
    #      summary: Payment cancellation request
    #      description: This method initiates the cancellation of a payment.
    #      operationId: cancelPayment
    #      tags:
    #        - Payment Initiation Service (PIS)
    #      parameters:
    #        #path
    #        - $ref: "#/components/parameters/paymentService"
    #        - $ref: "#/components/parameters/paymentId"
    #        #header
    #        - $ref: "#/components/parameters/X-Request-ID"
    #        - $ref: "#/components/parameters/TPP-Redirect-URI"
    #      responses:
    #        '204':
    #          $ref: "#/components/responses/NO_CONTENT_204_PaymentInitiationCancel"
    #        '403':
    #          $ref: "#/components/responses/FORBIDDEN_403_AIS"
    #        '404':
    #          $ref: "#/components/responses/NOT_FOUND_404_AIS"
    #        '500':
    #          $ref: "#/components/responses/INTERNAL_SERVER_ERROR_500_AIS"

    /{payment-service}/{payment-id}/status:
        get:
            summary: Payment initiation stauts request
            description: Check the transaction status of a payment initiation
            operationId: getPaymentInitiationStatus
            tags:
                - Payment Initiation Service (PIS)
            parameters:
                #path
                -   $ref: "#/components/parameters/paymentService"
                -   $ref: "#/components/parameters/paymentId"
                #header
                -   $ref: "#/components/parameters/X-Request-ID"
            responses:
                '200':
                    $ref: "#/components/responses/OK_200_PaymentInitiationStatus"
                '403':
                    $ref: "#/components/responses/FORBIDDEN_403_AIS"
                '404':
                    $ref: "#/components/responses/NOT_FOUND_404_AIS"
                '500':
                    $ref: "#/components/responses/INTERNAL_SERVER_ERROR_500_AIS"

    #######################################################
    # Account Information Service (AIS)
    #######################################################

    /accounts:
        get:
            summary: Read account list
            description: Returns all identifiers of the accounts, to which an account access has been granted to through the /consents endpoint by the PSU.
            operationId: getAccountList
            tags:
                - Account Information Service (AIS)
            parameters:
                #header
                -   $ref: "#/components/parameters/X-Request-ID"
            responses:
                '200':
                    $ref: "#/components/responses/OK_200_AccountList"
                '403':
                    $ref: "#/components/responses/FORBIDDEN_403_AIS"
                '404':
                    $ref: "#/components/responses/NOT_FOUND_404_AIS"
                '500':
                    $ref: "#/components/responses/INTERNAL_SERVER_ERROR_500_AIS"

    /accounts/{account-id}:
        get:
            summary: Read account details
            description: Returns details about an account.
            operationId: readAccountDetails
            tags:
                - Account Information Service (AIS)
            parameters:
                #path
                -   $ref: "#/components/parameters/accountId"
                #header
                -   $ref: "#/components/parameters/X-Request-ID"
                -   $ref: "#/components/parameters/consentId_header"
            responses:
                '200':
                    $ref: "#/components/responses/OK_200_AccountDetails"
                '403':
                    $ref: "#/components/responses/FORBIDDEN_403_AIS"
                '404':
                    $ref: "#/components/responses/NOT_FOUND_404_AIS"

    /accounts/{account-id}/balances:
        get:
            summary: Read balances
            description: Reads account data from a given account addressed by "account-id".
            operationId: getBalances
            tags:
                - Account Information Service (AIS)
            parameters:
                #path
                -   $ref: "#/components/parameters/accountId"
                #header
                -   $ref: "#/components/parameters/X-Request-ID"
                -   $ref: "#/components/parameters/consentId_header"
            responses:
                '200':
                    $ref: "#/components/responses/OK_200_Balances"
                '403':
                    $ref: "#/components/responses/FORBIDDEN_403_AIS"
                '404':
                    $ref: "#/components/responses/NOT_FOUND_404_AIS"
                '500':
                    $ref: "#/components/responses/INTERNAL_SERVER_ERROR_500_AIS"

    /accounts/{account-id}/transactions:
        get:
            summary: Read transaction list
            description: Reads a list of transactions from a given account addressed by "account-id".
            operationId: getTransactionList
            tags:
                - Account Information Service (AIS)
            parameters:
                #path
                -   $ref: "#/components/parameters/accountId"
                #query
                -   $ref: "#/components/parameters/dateFrom"
                -   $ref: "#/components/parameters/dateTo"
                #header
                -   $ref: "#/components/parameters/X-Request-ID"
                -   $ref: "#/components/parameters/consentId_header"
            responses:
