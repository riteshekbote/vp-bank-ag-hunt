                    $ref: "#/components/responses/OK_200_AccountsTransactions"
                '403':
                    $ref: "#/components/responses/FORBIDDEN_403_AIS"
                '404':
                    $ref: "#/components/responses/NOT_FOUND_404_AIS"
                '500':
                    $ref: "#/components/responses/INTERNAL_SERVER_ERROR_500_AIS"

